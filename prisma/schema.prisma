// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model HealthCheck {
  id        String   @id @default(cuid())
  message   String
  createdAt DateTime @default(now())
}

enum OrganizationRequestStatus {
  PENDING
  APPROVING
  APPROVED
  REJECTED
  APPROVAL_FAILED
  CANCELLED
}

enum OrganizationApprovalStage {
  CLAIMED
  ORGANIZATION_LINKED
  AUTH_INVITATION_PENDING
  AUTH_IDENTITY_LINKED
}

enum PlatformRole {
  USER
  SUPER_ADMIN
}

enum OrganizationRole {
  OWNER
  ADMIN
  PLANNER
  VIEWER
}

enum OrganizationInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
  DECLINED
}

enum InvitationDeliveryStatus {
  PENDING
  SENT
  // Kept for records created before copyable-link delivery was introduced.
  EXISTING_ACCOUNT
  FAILED
}

enum AuditScope {
  ORGANIZATION
  PLATFORM
}

enum AuditAction {
  CREATE
  UPDATE
  ACTIVATE
  DEACTIVATE
  INVITE
  RESEND_INVITATION
  INVITATION_DELIVERY_FAILED
  REVOKE_INVITATION
  REVOKE_SHARE
  ACCEPT_INVITATION
  DECLINE_INVITATION
  CHANGE_ROLE
  ACTIVATE_MEMBER
  DEACTIVATE_MEMBER
  TRANSFER_OWNERSHIP
  APPROVE_REQUEST
  REJECT_REQUEST
}

// ─── Multi-tenant foundation ──────────────────────────────────────────────────

model Organization {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  name              String  @db.VarChar(200)
  slug              String  @unique @db.VarChar(100)
  isActive          Boolean @default(true)
  vesselLabelConfig Json?
  exportTableConfig Json?

  members                 OrganizationMember[]
  requestsForOrganization OrganizationRequest[]    @relation("OrganizationForRequest")
  invitations             OrganizationInvitation[]

  companies          Company[]
  ports              Port[]
  terminals          Terminal[]
  berths             Berth[]
  vessels            Vessel[]
  services           Service[]
  vesselSchedules    VesselSchedule[]
  auditLogs          AuditLog[]
  plannerUndos       PlannerUndo[]
  berthPlannerShares BerthPlannerShare[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("organizations")
}

model User {
  id String @id @db.Uuid
  // This ID will later match Supabase Auth auth.users.id.

  email       String @unique @db.VarChar(255)
  displayName String @db.VarChar(200)

  platformRole PlatformRole @default(USER)
  isActive     Boolean      @default(true)

  memberships    OrganizationMember[]
  approvalsGiven OrganizationRequest[] @relation("ApprovedBy")

  sentOrganizationInvitations     OrganizationInvitation[] @relation("OrganizationInvitationInviter")
  acceptedOrganizationInvitations OrganizationInvitation[] @relation("OrganizationInvitationAcceptor")
  auditLogs                       AuditLog[]               @relation("AuditLogActor")
  createdBerthPlannerShares       BerthPlannerShare[]      @relation("BerthPlannerShareCreator")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([platformRole])
  @@index([isActive])
  @@map("users")
}

model OrganizationMember {
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role     OrganizationRole
  isActive Boolean          @default(true)

  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
  @@index([organizationId, isActive])
  @@map("organization_members")
}

// ─── Organization Request Model ───────────────────────────────────────────────

model OrganizationRequest {
  id String @id @default(cuid()) @db.VarChar(30)

  organizationName String  @db.VarChar(200)
  slug             String? @db.VarChar(100)

  requesterName  String  @db.VarChar(200)
  requesterEmail String  @db.VarChar(255)
  phone          String? @db.VarChar(50)
  message        String? @db.Text

  status OrganizationRequestStatus @default(PENDING)

  organizationId String?       @db.Uuid
  organization   Organization? @relation("OrganizationForRequest", fields: [organizationId], references: [id], onDelete: SetNull)

  authUserId String? @db.Uuid

  reviewedById String? @db.Uuid
  reviewedBy   User?   @relation("ApprovedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  reviewedAt        DateTime?
  approvalStartedAt DateTime?
  invitationSentAt  DateTime?
  approvalClaimId   String?                    @db.Uuid
  approvalClaimedAt DateTime?
  approvalVersion   Int                        @default(0)
  approvalStage     OrganizationApprovalStage?

  reviewNotes   String? @db.Text
  failureReason String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([requesterEmail])
  @@index([organizationId])
  @@index([reviewedById])
  @@index([approvalClaimedAt])
  @@index([createdAt])
  @@map("organization_requests")
}

model OrganizationInvitation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  email       String           @db.VarChar(255)
  displayName String?          @db.VarChar(200)
  role        OrganizationRole

  status         OrganizationInvitationStatus @default(PENDING)
  deliveryStatus InvitationDeliveryStatus     @default(PENDING)

  pendingKey String? @unique @db.VarChar(300)
  tokenHash  String  @unique @db.Char(64)

  authUserId String? @db.Uuid

  invitedById String @db.Uuid
  invitedBy   User   @relation("OrganizationInvitationInviter", fields: [invitedById], references: [id], onDelete: Restrict)

  acceptedById String? @db.Uuid
  acceptedBy   User?   @relation("OrganizationInvitationAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)

  deliveryAttemptedAt DateTime?
  invitationSentAt    DateTime?
  acceptedAt          DateTime?
  revokedAt           DateTime?
  expiresAt           DateTime

  deliveryError           String? @db.VarChar(500)
  deliveryFailureCategory String? @db.VarChar(80)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([email])
  @@index([status])
  @@index([expiresAt])
  @@index([invitedById])
  @@index([acceptedById])
  @@map("organization_invitations")
}

// ─── Operational models ───────────────────────────────────────────────────────

enum CompanyType {
  SHIPPING_LINE
  SHIPPING_AGENT
  TERMINAL_OPERATOR
  PORT_AUTHORITY
  OTHER
}

model Company {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String      @db.VarChar(20)
  name      String      @db.VarChar(200)
  shortName String?     @db.VarChar(100)
  type      CompanyType
  email     String?     @db.VarChar(255)
  phone     String?     @db.VarChar(50)
  address   String?
  isActive  Boolean     @default(true)

  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  operatedServices Service[] @relation("OperatorCompany")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, code])
  @@index([name])
  @@index([type])
  @@index([isActive])
  @@index([organizationId])
  @@map("companies")
}

model Service {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  code        String  @db.VarChar(30)
  name        String  @db.VarChar(200)
  description String?
  color       String  @default("#3B82F6") @db.VarChar(7)

  // operatorCompanyId maps to the existing "companyId" column — no column rename needed.
  operatorCompanyId String  @map("companyId") @db.Uuid
  operatorCompany   Company @relation("OperatorCompany", fields: [operatorCompanyId], references: [id])

  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schedules VesselSchedule[]

  @@unique([organizationId, code])
  @@index([name])
  // Preserve the existing index name on the underlying "companyId" column.
  @@index([operatorCompanyId], map: "services_companyId_idx")
  @@index([isActive])
  @@index([organizationId])
  @@map("services")
}

model Port {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  code     String  @db.VarChar(10)
  unlocode String? @db.VarChar(5)

  name     String @db.VarChar(200)
  country  String @db.VarChar(100)
  timezone String @db.VarChar(50)

  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)

  isActive Boolean @default(true)

  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  terminals Terminal[]

  @@unique([organizationId, code])
  @@unique([organizationId, unlocode])
  @@index([name])
  @@index([country])
  @@index([organizationId])
  @@map("ports")
}

enum VesselType {
  CONTAINER_SHIP
  BULK_CARRIER
  TANKER
  GENERAL_CARGO
  RO_RO
  OTHER
}

model Vessel {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  code     String     @unique @db.VarChar(20)
  name     String     @db.VarChar(200)
  imo      String?    @db.VarChar(10)
  callSign String?    @db.VarChar(10)
  flag     String?    @db.VarChar(3)
  type     VesselType

  lengthOverall Decimal? @db.Decimal(8, 2)
  beam          Decimal? @db.Decimal(8, 2)

  isActive Boolean @default(true)

  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schedules VesselSchedule[]

  @@unique([organizationId, imo])
  @@index([name])
  @@index([type])
  @@index([isActive])
  @@index([organizationId])
  @@map("vessels")
}

model Terminal {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  code String @db.VarChar(20)
  name String @db.VarChar(200)

  portId String @db.Uuid
  port   Port   @relation(fields: [portId], references: [id])

  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  berths             Berth[]
  schedules          VesselSchedule[]
  berthPlannerShares BerthPlannerShare[]

  @@unique([organizationId, portId, code])
  @@index([portId])
  @@index([name])
  @@index([organizationId])
  @@map("terminals")
}

enum ZeroOriginSide {
  LEFT
  RIGHT
}

model Berth {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  terminalId String   @db.Uuid
  terminal   Terminal @relation(fields: [terminalId], references: [id])

  code String @db.VarChar(20)
  name String @db.VarChar(200)

  berthLength    Decimal        @db.Decimal(8, 2)
  color          String         @default("#3B82F6") @db.VarChar(7)
  zeroOriginSide ZeroOriginSide @default(LEFT)
  sortOrder      Int            @default(0)

  isActive Boolean @default(true)

  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schedules VesselSchedule[]

  @@unique([organizationId, terminalId, code])
  @@index([terminalId])
  @@index([name])
  @@index([sortOrder])
  @@index([isActive])
  @@index([organizationId])
  @@map("berths")
}

enum ScheduleStatus {
  PLANNED
  CONFIRMED
  ARRIVED
  BERTHED
  DEPARTED
  CANCELLED
}

model VesselSchedule {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  vesselId String @db.Uuid
  vessel   Vessel @relation(fields: [vesselId], references: [id])

  terminalId String   @db.Uuid
  terminal   Terminal @relation(fields: [terminalId], references: [id])

  berthId String? @db.Uuid
  berth   Berth?  @relation(fields: [berthId], references: [id])

  serviceId String?  @db.Uuid
  service   Service? @relation(fields: [serviceId], references: [id])

  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  voyageNumber String? @db.VarChar(50)

  eta DateTime
  etb DateTime?
  etd DateTime

  ata DateTime?
  atb DateTime?
  atd DateTime?

  status  ScheduleStatus @default(PLANNED)
  remarks String?

  berthPositionMeters Int?
  headingReverse      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plannerUndos PlannerUndo[]

  @@index([vesselId])
  @@index([terminalId])
  @@index([berthId])
  @@index([serviceId])
  @@index([organizationId])
  @@index([eta])
  @@index([etd])
  @@index([status])
  @@map("vessel_schedules")
}

model PlannerUndo {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  scheduleId String         @db.Uuid
  schedule   VesselSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  originalAuditLogId String    @db.Uuid
  beforeData         Json
  expectedUpdatedAt  DateTime
  expiresAt          DateTime
  usedAt             DateTime?

  createdAt DateTime @default(now())

  @@index([organizationId, id])
  @@index([scheduleId])
  @@index([expiresAt])
  @@map("planner_undos")
}

model BerthPlannerShare {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publicId   String @unique @db.VarChar(32)
  secretHash String @db.Char(64)

  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  terminalId     String       @db.Uuid
  terminal       Terminal     @relation(fields: [terminalId], references: [id], onDelete: Cascade)
  createdById    String       @db.Uuid
  createdBy      User         @relation("BerthPlannerShareCreator", fields: [createdById], references: [id], onDelete: Restrict)

  startDate      String    @db.Char(10)
  endDate        String    @db.Char(10)
  rangeStart     DateTime
  rangeEnd       DateTime
  filters        Json?
  initialView    String    @db.VarChar(16)
  expiresAt      DateTime
  revokedAt      DateTime?
  lastAccessedAt DateTime?
  createdAt      DateTime  @default(now())

  sessions BerthPlannerShareSession[]

  @@index([organizationId, createdAt])
  @@index([terminalId])
  @@index([expiresAt])
  @@map("berth_planner_shares")
}

model BerthPlannerShareSession {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shareId        String            @db.Uuid
  share          BerthPlannerShare @relation(fields: [shareId], references: [id], onDelete: Cascade)
  tokenHash      String            @unique @db.Char(64)
  expiresAt      DateTime
  createdAt      DateTime          @default(now())
  lastAccessedAt DateTime?

  @@index([shareId, expiresAt])
  @@index([expiresAt])
  @@map("berth_planner_share_sessions")
}

model PublicRateLimitBucket {
  id        String   @id @db.Char(64)
  count     Int      @default(1)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resetAt])
  @@map("public_rate_limit_buckets")
}

model AuditLog {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  scope AuditScope

  organizationId String?       @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  actorUserId String? @db.Uuid
  actorUser   User?   @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  actorEmail       String? @db.VarChar(255)
  actorDisplayName String? @db.VarChar(200)

  action     AuditAction
  entityType String      @db.VarChar(100)
  entityId   String      @db.VarChar(100)
  entityName String?     @db.VarChar(250)

  beforeData Json?
  afterData  Json?
  metadata   Json?

  createdAt DateTime @default(now())

  @@index([scope])
  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([actorUserId])
  @@index([action])
  @@index([entityType])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
