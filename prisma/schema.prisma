// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model HealthCheck {
  id        String   @id @default(cuid())
  message   String
  createdAt DateTime @default(now())
}

enum OrganizationRequestStatus {
  PENDING
  APPROVING
  APPROVED
  REJECTED
  APPROVAL_FAILED
  CANCELLED
}

enum PlatformRole {
  USER
  SUPER_ADMIN
}

enum OrganizationRole {
  OWNER
  ADMIN
  PLANNER
  VIEWER
}

enum OrganizationInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
  DECLINED
}

enum InvitationDeliveryStatus {
  NOT_ATTEMPTED
  SENT
  EXISTING_ACCOUNT
  FAILED
}

// ─── Multi-tenant foundation ──────────────────────────────────────────────────

model Organization {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  name     String  @db.VarChar(200)
  slug     String  @unique @db.VarChar(100)
  isActive Boolean @default(true)

  members                 OrganizationMember[]
  requestsForOrganization OrganizationRequest[]    @relation("OrganizationForRequest")
  invitations             OrganizationInvitation[]

  companies       Company[]
  ports           Port[]
  terminals       Terminal[]
  berths          Berth[]
  vessels         Vessel[]
  services        Service[]
  vesselSchedules VesselSchedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("organizations")
}

model User {
  id String @id @db.Uuid
  // This ID will later match Supabase Auth auth.users.id.

  email       String @unique @db.VarChar(255)
  displayName String @db.VarChar(200)

  platformRole PlatformRole @default(USER)
  isActive     Boolean      @default(true)

  memberships    OrganizationMember[]
  approvalsGiven OrganizationRequest[] @relation("ApprovedBy")

  sentOrganizationInvitations     OrganizationInvitation[] @relation("OrganizationInvitationInviter")
  acceptedOrganizationInvitations OrganizationInvitation[] @relation("OrganizationInvitationAcceptor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([platformRole])
  @@index([isActive])
  @@map("users")
}

model OrganizationMember {
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role     OrganizationRole
  isActive Boolean          @default(true)

  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
  @@index([organizationId, isActive])
  @@map("organization_members")
}

// ─── Organization Request Model ───────────────────────────────────────────────

model OrganizationRequest {
  id String @id @default(cuid()) @db.VarChar(30)

  organizationName String  @db.VarChar(200)
  slug             String? @db.VarChar(100)

  requesterName  String  @db.VarChar(200)
  requesterEmail String  @db.VarChar(255)
  phone          String? @db.VarChar(50)
  message        String? @db.Text

  status OrganizationRequestStatus @default(PENDING)

  organizationId String?       @db.Uuid
  organization   Organization? @relation("OrganizationForRequest", fields: [organizationId], references: [id], onDelete: SetNull)

  authUserId String? @db.Uuid

  reviewedById String? @db.Uuid
  reviewedBy   User?   @relation("ApprovedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  reviewedAt        DateTime?
  approvalStartedAt DateTime?
  invitationSentAt  DateTime?

  reviewNotes   String? @db.Text
  failureReason String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([requesterEmail])
  @@index([organizationId])
  @@index([reviewedById])
  @@index([createdAt])
  @@map("organization_requests")
}

model OrganizationInvitation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  email       String           @db.VarChar(255)
  displayName String?          @db.VarChar(200)
  role        OrganizationRole

  status         OrganizationInvitationStatus @default(PENDING)
  deliveryStatus InvitationDeliveryStatus     @default(NOT_ATTEMPTED)

  pendingKey String? @unique @db.VarChar(300)

  authUserId String? @db.Uuid

  invitedById String @db.Uuid
  invitedBy   User   @relation("OrganizationInvitationInviter", fields: [invitedById], references: [id], onDelete: Restrict)

  acceptedById String? @db.Uuid
  acceptedBy   User?   @relation("OrganizationInvitationAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)

  invitationSentAt DateTime?
  acceptedAt       DateTime?
  revokedAt        DateTime?
  expiresAt        DateTime

  deliveryError String? @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([email])
  @@index([status])
  @@index([expiresAt])
  @@index([invitedById])
  @@index([acceptedById])
  @@map("organization_invitations")
}

// ─── Operational models ───────────────────────────────────────────────────────

enum CompanyType {
  SHIPPING_LINE
  SHIPPING_AGENT
  TERMINAL_OPERATOR
  PORT_AUTHORITY
  OTHER
}

model Company {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String      @db.VarChar(20)
  name      String      @db.VarChar(200)
  shortName String?     @db.VarChar(100)
  type      CompanyType
  email     String?     @db.VarChar(255)
  phone     String?     @db.VarChar(50)
  address   String?
  isActive  Boolean     @default(true)

  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  operatedServices Service[] @relation("OperatorCompany")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, code])
  @@index([name])
  @@index([type])
  @@index([isActive])
  @@index([organizationId])
  @@map("companies")
}

model Service {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  code        String  @db.VarChar(30)
  name        String  @db.VarChar(200)
  description String?
  color       String  @default("#3B82F6") @db.VarChar(7)

  // operatorCompanyId maps to the existing "companyId" column — no column rename needed.
  operatorCompanyId String  @map("companyId") @db.Uuid
  operatorCompany   Company @relation("OperatorCompany", fields: [operatorCompanyId], references: [id])

  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schedules VesselSchedule[]

  @@unique([organizationId, code])
  @@index([name])
  // Preserve the existing index name on the underlying "companyId" column.
  @@index([operatorCompanyId], map: "services_companyId_idx")
  @@index([isActive])
  @@index([organizationId])
  @@map("services")
}

model Port {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  code     String  @db.VarChar(10)
  unlocode String? @db.VarChar(5)

  name     String @db.VarChar(200)
  country  String @db.VarChar(100)
  timezone String @db.VarChar(50)

  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)

  isActive Boolean @default(true)

  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  terminals Terminal[]

  @@unique([organizationId, code])
  @@unique([organizationId, unlocode])
  @@index([name])
  @@index([country])
  @@index([organizationId])
  @@map("ports")
}

enum VesselType {
  CONTAINER_SHIP
  BULK_CARRIER
  TANKER
  GENERAL_CARGO
  RO_RO
  OTHER
}

model Vessel {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  code     String     @unique @db.VarChar(20)
  name     String     @db.VarChar(200)
  imo      String?    @db.VarChar(10)
  callSign String?    @db.VarChar(10)
  flag     String?    @db.VarChar(3)
  type     VesselType

  lengthOverall Decimal? @db.Decimal(8, 2)
  beam          Decimal? @db.Decimal(8, 2)

  isActive Boolean @default(true)

  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schedules VesselSchedule[]

  @@unique([organizationId, imo])
  @@index([name])
  @@index([type])
  @@index([isActive])
  @@index([organizationId])
  @@map("vessels")
}

model Terminal {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  code String @db.VarChar(20)
  name String @db.VarChar(200)

  portId String @db.Uuid
  port   Port   @relation(fields: [portId], references: [id])

  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  berths    Berth[]
  schedules VesselSchedule[]

  @@unique([organizationId, portId, code])
  @@index([portId])
  @@index([name])
  @@index([organizationId])
  @@map("terminals")
}

enum ZeroOriginSide {
  LEFT
  RIGHT
}

model Berth {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  terminalId String   @db.Uuid
  terminal   Terminal @relation(fields: [terminalId], references: [id])

  code String @db.VarChar(20)
  name String @db.VarChar(200)

  berthLength    Decimal        @db.Decimal(8, 2)
  color          String         @default("#3B82F6") @db.VarChar(7)
  zeroOriginSide ZeroOriginSide @default(LEFT)
  sortOrder      Int            @default(0)

  isActive Boolean @default(true)

  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schedules VesselSchedule[]

  @@unique([organizationId, terminalId, code])
  @@index([terminalId])
  @@index([name])
  @@index([sortOrder])
  @@index([isActive])
  @@index([organizationId])
  @@map("berths")
}

enum ScheduleStatus {
  PLANNED
  CONFIRMED
  ARRIVED
  BERTHED
  DEPARTED
  CANCELLED
}

model VesselSchedule {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  vesselId String @db.Uuid
  vessel   Vessel @relation(fields: [vesselId], references: [id])

  terminalId String   @db.Uuid
  terminal   Terminal @relation(fields: [terminalId], references: [id])

  berthId String? @db.Uuid
  berth   Berth?  @relation(fields: [berthId], references: [id])

  serviceId String?  @db.Uuid
  service   Service? @relation(fields: [serviceId], references: [id])

  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  voyageNumber String? @db.VarChar(50)

  eta DateTime
  etb DateTime?
  etd DateTime

  ata DateTime?
  atb DateTime?
  atd DateTime?

  status  ScheduleStatus @default(PLANNED)
  remarks String?

  berthPositionMeters Int?
  headingReverse      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vesselId])
  @@index([terminalId])
  @@index([berthId])
  @@index([serviceId])
  @@index([organizationId])
  @@index([eta])
  @@index([etd])
  @@index([status])
  @@map("vessel_schedules")
}
