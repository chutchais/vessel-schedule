// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model HealthCheck {
  id        String   @id @default(cuid())
  message   String
  createdAt DateTime @default(now())
}

enum CompanyType {
  SHIPPING_LINE
  SHIPPING_AGENT
  TERMINAL_OPERATOR
  PORT_AUTHORITY
  OTHER
}

model Company {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String      @unique @db.VarChar(20)
  name      String      @db.VarChar(200)
  shortName String?     @db.VarChar(100)
  type      CompanyType
  email     String?     @db.VarChar(255)
  phone     String?     @db.VarChar(50)
  address   String?
  isActive  Boolean     @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([type])
  @@index([isActive])
  @@map("companies")
}

model Port {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  code     String  @unique @db.VarChar(10)
  unlocode String? @unique @db.VarChar(5)

  name     String @db.VarChar(200)
  country  String @db.VarChar(100)
  timezone String @db.VarChar(50)

  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  terminals Terminal[]

  @@index([name])
  @@index([country])
  @@map("ports")
}

enum VesselType {
  CONTAINER_SHIP
  BULK_CARRIER
  TANKER
  GENERAL_CARGO
  RO_RO
  OTHER
}

model Vessel {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  code     String     @unique @db.VarChar(20)
  name     String     @db.VarChar(200)
  imo      String?    @unique @db.VarChar(10)
  callSign String?    @db.VarChar(10)
  flag     String?    @db.VarChar(3)
  type     VesselType

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([type])
  @@index([isActive])
  @@map("vessels")
}

model Terminal {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  code String @db.VarChar(20)
  name String @db.VarChar(200)

  portId String @db.Uuid
  port   Port   @relation(fields: [portId], references: [id])

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([portId, code])
  @@index([portId])
  @@index([name])
  @@map("terminals")
}
