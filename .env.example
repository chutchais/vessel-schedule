# Placeholder-only production template. Store real values in the hosting secret manager.
NODE_ENV=production

# Application runtime connection (usually pooled) and direct Prisma migration connection.
DATABASE_URL=postgresql://flowport_app:replace-with-secret@pooler.example.invalid:6543/flowport?sslmode=require
DIRECT_URL=postgresql://flowport_migrator:replace-with-secret@db.example.invalid:5432/flowport?sslmode=require
# Required for every Prisma CLI command. Production deploys must use "production".
DATABASE_ENVIRONMENT=production
# Replace with the exact sanitized value required by the database target guard.
DATABASE_TARGET_APPROVAL=production@db.example.invalid:5432/flowport
# Required only when DATABASE_URL and DIRECT_URL use different host identities.
DATABASE_TARGET_PAIR_APPROVAL=pooler.example.invalid:6543/flowport|db.example.invalid:5432/flowport

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
SUPABASE_SECRET_KEY=replace-with-server-secret-key

# Both origins must match. They construct auth, invitation, and public share links.
APP_URL=https://getflowport.com
NEXT_PUBLIC_APP_URL=https://getflowport.com

# Explicit fail-closed email mode. Use disabled for private validation without SMTP.
# Use smtp only when every SMTP variable below is configured and verified.
EMAIL_DELIVERY_MODE=disabled
SMTP_HOST=replace-with-smtp-host
SMTP_PORT=replace-with-smtp-port
SMTP_SECURE=replace-with-true-or-false
SMTP_USER=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
# Sender name and email are supplied together in this header-safe value.
EMAIL_FROM=replace-with-sender-name-and-email

# Read-only public Berth Planner shares (server-only; disabled by default)
PUBLIC_PLANNER_SHARING_ENABLED=false
# Number of trusted reverse-proxy hops allowed to supply X-Forwarded-For (0 ignores it)
PUBLIC_PLANNER_TRUSTED_PROXY_HOPS=0

# Optional; most hosting providers assign this automatically.
PORT=3000
