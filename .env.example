DATABASE_URL=
DIRECT_URL=
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key
SUPABASE_SECRET_KEY=your-service-role-key
# Trusted canonical application URL used to construct invitation links.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# SMTP is server-only. In development, leave these unset to log only recipient,
# subject and message type; production requires every SMTP variable below.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=example-user
SMTP_PASSWORD=replace-with-a-secret
EMAIL_FROM=Vessel Schedule <no-reply@example.com>
# Read-only public Berth Planner shares (server-only; disabled by default)
PUBLIC_PLANNER_SHARING_ENABLED=false
# Number of trusted reverse-proxy hops allowed to supply X-Forwarded-For (0 ignores it)
PUBLIC_PLANNER_TRUSTED_PROXY_HOPS=0
